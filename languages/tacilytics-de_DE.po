#: tacilytics.php:80
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-tacilytics-admin.php:36
#: includes/class-tacilytics-admin.php:37
#: includes/class-tacilytics-admin.php:160
msgid "Tacilytics"
msgstr "Tacilytics"

#: includes/class-tacilytics-admin.php:104
msgid "Tacilytics is installed but not counting yet."
msgstr "Tacilytics ist installiert, zählt aber noch nicht."

#: includes/class-tacilytics-admin.php:106
msgid "Finish the setup"
msgstr "Einrichtung abschließen"

#: includes/class-tacilytics-admin.php:115
#: includes/class-tacilytics-admin.php:139
msgid "You are not allowed to do this."
msgstr "Dazu hast du keine Berechtigung."

#: includes/class-tacilytics-admin.php:121
msgid "Tracker script reachable."
msgstr "Tracker-Skript erreichbar."

#. translators: %d: visitors today
#: includes/class-tacilytics-admin.php:127
#, php-format
msgid "API key works: %d visitors today."
msgstr "API-Schlüssel funktioniert: heute %d Besucher."

#: includes/class-tacilytics-admin.php:214
msgid ""
"Cookieless analytics: no cookies, no IP addresses stored, no personal "
"profiles. Where should your statistics live?"
msgstr ""
"Statistik ohne Cookies: keine Cookies, keine gespeicherten IP-Adressen, "
"keine Personenprofile. Wo sollen deine Statistiken liegen?"

#: includes/class-tacilytics-admin.php:218
#: includes/class-tacilytics-admin.php:353
msgid "Self-hosted"
msgstr "Selbst gehostet"

#: includes/class-tacilytics-admin.php:219
msgid ""
"You run Tacilytics on your own server (open source, MIT). Free forever, your "
"data never leaves your server."
msgstr ""
"Du betreibst Tacilytics auf deinem eigenen Server (Open Source, MIT). Für "
"immer kostenlos, deine Daten verlassen nie deinen Server."

#: includes/class-tacilytics-admin.php:220
msgid "Connect my server →"
msgstr "Meinen Server verbinden →"

#: includes/class-tacilytics-admin.php:225
#: includes/class-tacilytics-admin.php:233
#: includes/class-tacilytics-admin.php:300
msgid "Tacilytics Cloud"
msgstr "Tacilytics Cloud"

#: includes/class-tacilytics-admin.php:226
msgid "We host it for you in Germany. Nothing to install or maintain."
msgstr ""
"Wir hosten es für dich in Deutschland. Nichts zu installieren oder zu warten."

#: includes/class-tacilytics-admin.php:227
msgid "90 days free, then €1.99 per site per month or €9.99 per year"
msgstr ""
"90 Tage gratis, danach 1,99 € pro Website und Monat oder 9,99 € im Jahr"

#: includes/class-tacilytics-admin.php:228
msgid "Use Tacilytics Cloud →"
msgstr "Tacilytics Cloud nutzen →"

#: includes/class-tacilytics-admin.php:234
msgid ""
"A hosted version is planned. It is not available yet, and this plugin does "
"not contact it."
msgstr ""
"Eine gehostete Version ist geplant. Sie ist noch nicht verfügbar, und dieses "
"Plugin nimmt keinen Kontakt zu ihr auf."

#: includes/class-tacilytics-admin.php:235
msgid "Coming soon"
msgstr "Bald verfügbar"

#: includes/class-tacilytics-admin.php:250
msgid "Back"
msgstr "Zurück"

#: includes/class-tacilytics-admin.php:258
msgid "Connect your Tacilytics server"
msgstr "Deinen Tacilytics-Server verbinden"

#: includes/class-tacilytics-admin.php:260
msgid "In your Tacilytics dashboard, add this site (the domain below)."
msgstr ""
"Füge diese Website in deinem Tacilytics-Dashboard hinzu (die Domain unten)."

#: includes/class-tacilytics-admin.php:261
msgid "Enter the address of your dashboard here and save."
msgstr "Trag hier die Adresse deines Dashboards ein und speichere."

#: includes/class-tacilytics-admin.php:270
msgid "Save and start counting"
msgstr "Speichern und loszählen"

#. translators: %s: link to the GitHub repository
#: includes/class-tacilytics-admin.php:276
#, php-format
msgid "No server yet? Tacilytics is open source: %s"
msgstr "Noch keinen Server? Tacilytics ist Open Source: %s"

#: includes/class-tacilytics-admin.php:302
msgid "Hosted in Germany, data processing agreement included"
msgstr "Gehostet in Deutschland, inklusive Auftragsverarbeitungsvertrag (AVV)"

#: includes/class-tacilytics-admin.php:303
msgid ""
"Up to 50,000 page views per site and month, €1.99 per month or €9.99 per year"
msgstr ""
"Bis zu 50.000 Seitenaufrufe pro Website und Monat, 1,99 € im Monat oder 9,99 "
"€ im Jahr"

#: includes/class-tacilytics-admin.php:304
msgid "First 90 days free, nothing is charged before they end"
msgstr "Die ersten 90 Tage gratis, vorher wird nichts abgebucht"

#: includes/class-tacilytics-admin.php:305
msgid "Cancel any time, export your data as CSV"
msgstr "Jederzeit kündbar, Daten als CSV exportierbar"

#: includes/class-tacilytics-admin.php:308
msgid "Coming soon."
msgstr "Bald verfügbar."

#: includes/class-tacilytics-admin.php:308
msgid ""
"Tacilytics Cloud is opening shortly. Until then you can use your own server, "
"it takes about five minutes."
msgstr ""
"Tacilytics Cloud startet in Kürze. Bis dahin kannst du deinen eigenen Server "
"nutzen, das dauert etwa fünf Minuten."

#: includes/class-tacilytics-admin.php:309
msgid "Use my own server instead"
msgstr "Stattdessen eigenen Server nutzen"

#. translators: %s: link to the Cloud sign-up page
#: includes/class-tacilytics-admin.php:321
#, php-format
msgid ""
"Create your Cloud account with this domain at %s, then save here. Tracking "
"starts as soon as both are done."
msgstr ""
"Leg dein Cloud-Konto mit dieser Domain auf %s an und speichere dann hier. "
"Gezählt wird, sobald beides erledigt ist."

#: includes/class-tacilytics-admin.php:326
msgid "Connect to Tacilytics Cloud"
msgstr "Mit Tacilytics Cloud verbinden"

#. translators: 1: domain, 2: server
#: includes/class-tacilytics-admin.php:348
#, php-format
msgid "Counting %1$s on %2$s"
msgstr "Zählt %1$s auf %2$s"

#: includes/class-tacilytics-admin.php:353
msgid "Cloud"
msgstr "Cloud"

#: includes/class-tacilytics-admin.php:360
msgid "Connection"
msgstr "Verbindung"

#: includes/class-tacilytics-admin.php:369
msgid "API key (optional)"
msgstr "API-Schlüssel (optional)"

#: includes/class-tacilytics-admin.php:372
msgid ""
"Shows your numbers on the WordPress dashboard. Create a read-only key in "
"Tacilytics under Settings → Security → API keys. The key stays on your "
"server and is never sent to visitors."
msgstr ""
"Zeigt deine Zahlen im WordPress-Dashboard. Leg in Tacilytics unter "
"Einstellungen → Sicherheit → API-Schlüssel einen Schlüssel nur zum Lesen an. "
"Der Schlüssel bleibt auf deinem Server und wird nie an Besucher geschickt."

#: includes/class-tacilytics-admin.php:377
msgid "What to count"
msgstr "Was gezählt wird"

#: includes/class-tacilytics-admin.php:380
msgid "Automatic events"
msgstr "Automatische Ereignisse"

#: includes/class-tacilytics-admin.php:383
msgid "Clicks on links to other websites"
msgstr "Klicks auf Links zu anderen Websites"

#: includes/class-tacilytics-admin.php:384
msgid "File downloads (PDF, ZIP, …)"
msgstr "Datei-Downloads (PDF, ZIP, …)"

#: includes/class-tacilytics-admin.php:385
msgid "Site search: search terms and whether there were results"
msgstr "Suche auf der Website: Suchbegriffe und ob es Treffer gab"

#: includes/class-tacilytics-admin.php:386
msgid "Broken links (404 pages)"
msgstr "Kaputte Links (404-Seiten)"

#: includes/class-tacilytics-admin.php:388
msgid "WooCommerce purchases with revenue (no customer data)"
msgstr "WooCommerce-Käufe mit Umsatz (ohne Kundendaten)"

#: includes/class-tacilytics-admin.php:394
msgid "Do not count"
msgstr "Nicht zählen"

#: includes/class-tacilytics-admin.php:399
msgid ""
"Visits of logged-in users with these roles are not counted, also on cached "
"pages. Takes effect on the next visit while logged in. The browser stays "
"excluded after logout until someone logs in there with a role that is "
"counted."
msgstr ""
"Besuche angemeldeter Nutzer mit diesen Rollen werden nicht gezählt, auch auf "
"gecachten Seiten. Das gilt ab dem nächsten Besuch als angemeldeter Nutzer. "
"Nach dem Abmelden bleibt der Browser ausgeschlossen, bis sich dort jemand "
"mit einer Rolle anmeldet, die gezählt wird."

#: includes/class-tacilytics-admin.php:403
msgid "Privacy"
msgstr "Datenschutz"

#: includes/class-tacilytics-admin.php:405
msgid "Respect \"Do Not Track\" and Global Privacy Control"
msgstr "„Do Not Track“ und Global Privacy Control respektieren"

#: includes/class-tacilytics-admin.php:416
msgid "Test connection"
msgstr "Verbindung testen"

#: includes/class-tacilytics-admin.php:418
msgid "Open dashboard"
msgstr "Dashboard öffnen"

#: includes/class-tacilytics-admin.php:419
msgid ""
"Disconnect this site? Tracking stops until you set it up again. Data on the "
"server is not deleted."
msgstr ""
"Diese Website trennen? Es wird nicht mehr gezählt, bis du sie wieder "
"einrichtest. Die Daten auf dem Server bleiben erhalten."

#: includes/class-tacilytics-admin.php:422
msgid "Disconnect"
msgstr "Trennen"

#: includes/class-tacilytics-admin.php:436
msgid "Server address"
msgstr "Server-Adresse"

#: includes/class-tacilytics-admin.php:439
msgid "The address of your Tacilytics dashboard."
msgstr "Die Adresse deines Tacilytics-Dashboards."

#: includes/class-tacilytics-admin.php:453
msgid "Site domain"
msgstr "Domain der Website"

#: includes/class-tacilytics-admin.php:456
msgid "Must match the site in Tacilytics exactly (without www.)."
msgstr "Muss genau mit der Website in Tacilytics übereinstimmen (ohne www.)."

#: includes/class-tacilytics-api.php:32 includes/class-tacilytics-api.php:150
#: includes/class-tacilytics-dashboard-widget.php:48
msgid "Tacilytics is not set up yet."
msgstr "Tacilytics ist noch nicht eingerichtet."

#: includes/class-tacilytics-api.php:38
msgid "No API key saved."
msgstr "Kein API-Schlüssel gespeichert."

#: includes/class-tacilytics-api.php:64
msgid ""
"The API key was rejected. Check that it belongs to this server and has "
"access to this site."
msgstr ""
"Der API-Schlüssel wurde abgelehnt. Prüfe, ob er zu diesem Server gehört und "
"Zugriff auf diese Website hat."

#: includes/class-tacilytics-api.php:67
msgid ""
"This site was not found on the server. Add it in your Tacilytics dashboard "
"first."
msgstr ""
"Diese Website gibt es auf dem Server nicht. Füge sie zuerst in deinem "
"Tacilytics-Dashboard hinzu."

#. translators: %d: HTTP status code
#: includes/class-tacilytics-api.php:71
#, php-format
msgid "Unexpected answer from the server (HTTP %d)."
msgstr "Unerwartete Antwort vom Server (HTTP %d)."

#. translators: %d: HTTP status code
#: includes/class-tacilytics-api.php:164
#, php-format
msgid ""
"The tracker script was not found on this server (HTTP %d). Is the address "
"right?"
msgstr ""
"Das Tracker-Skript wurde auf diesem Server nicht gefunden (HTTP %d). Stimmt "
"die Adresse?"

#: includes/class-tacilytics-dashboard-widget.php:39
msgid "Tacilytics – last 7 days"
msgstr "Tacilytics – letzte 7 Tage"

#: includes/class-tacilytics-dashboard-widget.php:48
msgid "Set it up"
msgstr "Jetzt einrichten"

#: includes/class-tacilytics-dashboard-widget.php:52
msgid "Tracking is active. Add a read-only API key to see your numbers here."
msgstr ""
"Es wird gezählt. Hinterlege einen API-Schlüssel nur zum Lesen, um deine "
"Zahlen hier zu sehen."

#: includes/class-tacilytics-dashboard-widget.php:52
msgid "Add API key"
msgstr "API-Schlüssel hinzufügen"

#: includes/class-tacilytics-dashboard-widget.php:66
msgid "Visitors"
msgstr "Besucher"

#: includes/class-tacilytics-dashboard-widget.php:71
msgid "Page views"
msgstr "Seitenaufrufe"

#: includes/class-tacilytics-dashboard-widget.php:73
msgid "Revenue"
msgstr "Umsatz"

#: includes/class-tacilytics-dashboard-widget.php:75
msgid "Bounce rate"
msgstr "Absprungrate"

#: includes/class-tacilytics-dashboard-widget.php:80
msgid "Top pages"
msgstr "Top-Seiten"

#: includes/class-tacilytics-dashboard-widget.php:81
msgid "Top sources"
msgstr "Top-Quellen"

#: includes/class-tacilytics-dashboard-widget.php:83
msgid "Open full dashboard →"
msgstr "Ganzes Dashboard öffnen →"

#: includes/class-tacilytics-dashboard-widget.php:103
msgid "Visitors per day"
msgstr "Besucher pro Tag"

#: includes/class-tacilytics-dashboard-widget.php:146
msgid "No data yet"
msgstr "Noch keine Daten"

#: includes/class-tacilytics-settings.php:196
msgid ""
"The server address must start with https:// (http is only allowed for "
"localhost)."
msgstr ""
"Die Server-Adresse muss mit https:// beginnen (http ist nur für localhost "
"erlaubt)."

#: includes/class-tacilytics-settings.php:205
msgid "Please enter a valid domain, e.g. example.com."
msgstr "Bitte gib eine gültige Domain ein, z. B. example.com."

#: includes/class-tacilytics-settings.php:226
msgid ""
"API keys start with tk_. Create a read-only key under Settings → Security in "
"your Tacilytics dashboard."
msgstr ""
"API-Schlüssel beginnen mit tk_. Leg in deinem Tacilytics-Dashboard unter "
"Einstellungen → Sicherheit einen Schlüssel nur zum Lesen an."

#: includes/class-tacilytics-settings.php:252
msgid ""
"The server changed, so the saved API key was removed. Please add a key from "
"the new server."
msgstr ""
"Der Server wurde geändert, deshalb wurde der gespeicherte API-Schlüssel "
"entfernt. Bitte hinterlege einen Schlüssel vom neuen Server."
